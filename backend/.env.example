# Environment
DEBUG=True

# LLM API Configuration - choose one provider
# Supported providers: zhipu, moonshot, deepseek, volcengine
LLM_PROVIDER=zhipu
# Zhipu GLM
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-4
# Kimi Moonshot
# MOONSHOT_API_KEY=your_moonshot_api_key_here
# MOONSHOT_MODEL=moonshot-v1-8k
# DeepSeek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-chat
# Volcengine (Doubao/火山方舟)
# VOLCENGINE_API_KEY=your_volcengine_api_key_here
# VOLCENGINE_MODEL=ep-20250528XXXXXX-coding
# VOLCENGINE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3

# Rate limiting
FREE_DAILY_LIMIT=1

# Redis
REDIS_URL=redis://localhost:6379/0
